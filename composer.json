{
    "name": "aregowe/magento2-module-polyshell-protection",
    "version": "1.4.1",
    "description": "Comprehensive defense-in-depth module that closes the PolyShell unrestricted file upload vulnerability (APSB25-94) in Adobe Commerce and Magento Open Source.",
    "require": {
        "php": "^8.1",
        "magento/framework": "^103"
    },
    "replace": {
        "markshust/magento2-module-polyshell-patch": "*"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpunit/phpunit": "^10.5",
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "type": "magento2-module",
    "license": [
        "MIT"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Aregowe\\PolyShellProtection\\": ""
        }
    },
    "repositories": [{
        "name": "magento",
        "type": "composer",
        "url": "https://repo.magento.com/"
    }],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
